{
  "$schema": "../socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "repoName": "decmpfs",
  "docs": {
    "surfaces": [
      {
        "kind": "api",
        "hub": "docs/api.md",
        "sources": [
          "crates/decmpfs/src/lib.rs",
          "crates/decmpfs/src/gate.rs",
          "crates/decmpfs/src/remove.rs",
          "crates/decmpfs/src/stream.rs"
        ]
      },
      {
        "kind": "commands",
        "hub": "docs/commands.md",
        "sources": ["crates/decmpfs/src/bin/decmpfs.rs"]
      }
    ]
  },
  "repo": {
    "type": "solo"
  },
  "build": {
    "from": "crates-registry",
    "type": "rust"
  },
  "secondaries": [
    {
      "from": "npm-registry",
      "type": "addon"
    }
  ],
  "napi": {
    "platforms": [
      "darwin-arm64",
      "darwin-x64",
      "linux-arm64-gnu",
      "linux-x64-gnu",
      "win32-x64-msvc",
      "linux-arm64-musl",
      "linux-x64-musl",
      "win32-arm64-msvc"
    ],
    "artifactFiles": {
      "decmpfs.node": "npm/{target}/decmpfs.{target}.node"
    }
  },
  "ai": {
    "localAssist": true
  },
  "fuzz": {
    "exempt": true,
    "reason": "JS surface is thin napi glue over the Rust core; the untrusted-input boundary (decmpfs header/xattr decode) is fuzzed in Rust via cargo-fuzz fuzz/fuzz_targets, which stays in place. A vitiate JS lane would only re-fuzz the binding shims."
  },
  "release": {
    "versionPolicy": "patch-only"
  },
  "capabilities": {
    "cargo": ["."]
  }
}
